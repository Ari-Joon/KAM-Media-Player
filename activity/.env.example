# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Exposed to the browser by Vite. Must equal DISCORD_CLIENT_ID.
VITE_DISCORD_CLIENT_ID=

# Optional. Without it, free-text searches use SoundCloud and YouTube lookup is disabled.
# This key does not authorise downloading or rebroadcasting YouTube media.
YOUTUBE_API_KEY=

# Path to yt-dlp if it isn't on PATH.
YTDLP_BIN=yt-dlp

PORT=3000
CACHE_DIR=./cache
# On Windows this must be `python` (or `py`); `python3` does not exist there.
PYTHON_BIN=python3
VISUALCORE_PATH=../visualcore/src
CLIENT_DIR=client/dist

# Lyric transcription. Requires `pip install faster-whisper` in the visualcore
# environment; without it this has no effect. Set to 0 to disable even when the
# package is installed.
TRANSCRIBE_LYRICS=1

# SoundCloud official API. Register at https://developers.soundcloud.com
#
# STRONGLY RECOMMENDED. With both values set, SoundCloud audio is streamed
# through their documented API under their developer terms - the only provider
# path in this project suitable for a deployment you intend to operate publicly
# or commercially. Without them, SoundCloud falls back to extraction, which
# breaches their terms exactly as the YouTube path does.
#
# NOTE: registration is not free. SoundCloud require an Artist Pro subscription
# to issue API credentials at all, so the licensed path carries a recurring
# cost. Left blank, the server says so at boot and at /healthz rather than
# quietly running unlicensed.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --- Public HTTPS address ----------------------------------------------------
#
# Discord loads an Activity only over HTTPS from a hostname you have registered
# in the Developer Portal, and it offers no API for URL mappings - so a hostname
# that changes means editing the Portal by hand every session.
#
# quick        (default) Cloudflare quick tunnel. Free, no account, but a new
#              hostname on every start. Fine for a first look; tiresome after.
# ngrok        A permanent hostname. PAID PLANS ONLY: the free tier serves a
#              browser interstitial that Discord's embedded browser receives
#              instead of the app, so the Activity shows a white screen.
#              See DEPLOY.md - curl will not reveal this, only a browser UA.
# cloudflared  A Cloudflare named tunnel. Free forever, but it needs a domain
#              already on your Cloudflare account.
#
# See DEPLOY.md for the one-time setup behind each.
TUNNEL_PROVIDER=quick

# The permanent hostname, without a scheme. Required by ngrok and cloudflared.
#   ngrok        kam-media-player.ngrok-free.app
#   cloudflared  kam.example.com
TUNNEL_DOMAIN=

# Cloudflare named tunnels only: the tunnel's name, as given to
# `cloudflared tunnel create`.
TUNNEL_NAME=
